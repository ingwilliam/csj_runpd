DB_HOST=127.0.0.1
DB_PORT=1433
DB_NAME=runpd
DB_USER=sa
DB_PASSWORD=
DB_TRUST_SERVER_CERTIFICATE=true

# Clave de firma JWT: mínimo 32 bytes. Genera una clave propia para cada entorno.
JWT_SECRET=

# Servidor SMTP para el correo de recuperación de contraseña.
# Para MailDev local: SMTP_HOST=localhost, SMTP_PORT=1025, sin usuario, sin contraseña y SMTP_ENABLE_SSL=false.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=RUNPD <no-responder@runpd.local>
SMTP_ENABLE_SSL=false

# Administrador inicial: garantiza su rol, estado activo y contraseña inicial al arrancar.
ADMIN_EMAIL=
# Obligatoria solo si el usuario de ADMIN_EMAIL no existe; mínimo 8 caracteres.
ADMIN_PASSWORD=
# Nombres usados solo al crear el usuario; los segundos son opcionales.
ADMIN_PRIMER_NOMBRE=Administrador
ADMIN_SEGUNDO_NOMBRE=
ADMIN_PRIMER_APELLIDO=Sistema
ADMIN_SEGUNDO_APELLIDO=
